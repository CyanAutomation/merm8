{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "worker/**/*.ts",
    "worker-tests/**/*.ts",
    "scripts/**/*.ts",
    "parser-node/**/*.ts"
  ]
}

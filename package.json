{
  "name": "merm8-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:worker": "node --import tsx --test worker-tests/*.test.ts",
    "test:workflows": "node --import tsx --test scripts/validate-kaseki-url.test.ts scripts/validate-kaseki-run-id.test.ts scripts/validate-kaseki-workflows.test.ts scripts/validate-ci-workflows.test.ts",
    "test:parser": "node --import tsx --test parser-node/parse.test.ts",
    "test:skills": "node --import tsx --test scripts/validate-skills.test.ts",
    "test:readme-links": "node --import tsx --test scripts/check-readme-links.test.ts",
    "check:readme-links": "node --import tsx scripts/check-readme-links.ts",
    "check:readme-links:external": "node --import tsx scripts/check-readme-links.ts --external",
    "test": "npm run typecheck && npm run test:worker && npm run test:workflows && npm run test:parser && npm run test:skills && npm run test:readme-links && npm run check:readme-links",
    "check": "npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^24.19.2",
    "fallow": "3.34.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
